{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "github"
  ],
  "disabledMcpjsonServers": [
    "shadcn"
  ],
  "permissions": {
    "allow": [
      "mcp__github",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge --no-ff *)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(git push -u origin sprint/*)",
      "Bash(git push origin sprint/*)",
      "Bash(bash scripts/housekeeping.sh*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * develop*)",
      "Bash(git push * release/*)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(sudo *)",
      "Bash(curl * | *sh*)",
      "Bash(wget * | *sh*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  }
}
